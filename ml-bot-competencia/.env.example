# Copia este archivo como ".env" en la misma carpeta y completa los valores
# reales. El ".env" real NUNCA se sube a GitHub (ver .gitignore).

COMP_SELLER_ID=107584006
COMP_TIENDA_URL=https://listado.mercadolibre.com.ar/tienda/levys-bazar/
COMP_NOMBRE_VENDEDOR=Levys Bazar,Tushka

# Token del bot de Telegram y chat_id donde llegan los avisos.
# Se consiguen hablando con @BotFather (token) y @userinfobot o similar (chat_id).
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Cada cuanto se revisa un lote de publicaciones (en segundos). 10800 = 3 horas.
COMP_INTERVALO_SEGUNDOS=10800

HEADLESS=false
# true = la ventana de Chrome del bot queda fuera de pantalla en vez de tapar el escritorio.
COMP_OCULTAR_VENTANA=true
COMP_LOG_CONSOLE=false
COMP_ITEMS_POR_CICLO=150

# Opcionales, tienen default razonable si no se definen:
# MAX_PAGINAS=80
# POR_PAGINA=48
# COMP_RELISTAR_CADA_HORAS=24
# COMP_MAX_INTENTOS_RELANZAR=3
# COMP_CICLOS_FALLIDOS_PARA_AVISAR=2

# Sincronización con el panel de Tampermonkey (levys-copilot.user.js): si
# se completan estos dos valores, este bot le sube al panel (vía Firestore,
# el mismo proyecto que ya usa el panel) las publicaciones donde detectó un
# competidor nuevo. Si se dejan vacíos, el bot sigue funcionando igual,
# solo que el panel no muestra sus avisos. Ninguno de los dos es secreto
# por sí solo -- son los mismos valores que están en CLOUD_CONFIG dentro
# de levys-copilot.user.js (ver LEEME.md del panel, "Sincronización en la
# nube"). Ya están completados acá con los del proyecto "panel-levys" que
# ya está en uso -- no hace falta crear uno nuevo.
FIREBASE_API_KEY=AIzaSyC7bYwZ8DfZ_CLg-GFCz7TXZMHWHR9yDwY
FIREBASE_PROJECT_ID=panel-levys
